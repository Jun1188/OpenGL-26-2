<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy to OpenGL.local.props and use actual extracted package paths.
       Every directory value must end with a backslash. -->
  <PropertyGroup>
    <GlewRoot>C:\OpenGL\glew-2.3.1\</GlewRoot>
    <GlfwRoot>C:\OpenGL\glfw-3.4.bin.WIN64\</GlfwRoot>
    <GlmRoot>C:\OpenGL\glm\</GlmRoot>
    <GlfwLibraryDir>$(GlfwRoot)lib-vc2022\</GlfwLibraryDir>
  </PropertyGroup>
</Project>
