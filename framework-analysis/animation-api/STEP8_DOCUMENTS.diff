+inline bool validJointRest(const Transform3D&amp; rest) {
+    return DiagramSystem::validTransform(rest) &amp;&amp; rest.scale.x &gt; 1e-6f
+        &amp;&amp; std::abs(rest.scale.x - rest.scale.y) &lt; 1e-6f
+        &amp;&amp; std::abs(rest.scale.x - rest.scale.z) &lt; 1e-6f;
