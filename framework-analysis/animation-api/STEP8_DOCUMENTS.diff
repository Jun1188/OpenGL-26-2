+/// 거리 기반 격자 예제를 구성한다.
+bool Console::initGrid() {
+    auto&amp; scene=app_.getScene();scene.clear();demo_=Demo::Grid;clock_.reset();gridBoxes_.clear();
+    graphics::GridLayout grid;grid.origin={-3,-.1f,-2};grid.extent={6,.2f,4};grid.cells={6,1,4};
