+    camera.position = {11, 10, 13};
+    camera.target = {0, .7f, .3f};
+    camera.up = {0, 1, 0};
+    camera.orthographic = false;
+    camera.orthographicHalfExtent = 7.5f;
+    camera.nearPlane = .1f;
+    camera.farPlane = 120;
+    require(graphics::CameraSystem::validCamera(camera), &quot;Reset camera is invalid.&quot;);
+    placeMovingObjects();
