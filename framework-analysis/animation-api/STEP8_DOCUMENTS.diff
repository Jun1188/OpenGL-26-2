+inline std::optional&lt;LayerId&gt; Scene::getEntityLayer(EntityId id) const {
+    if (id &gt;= components_.size()) return {};
+    const auto found = entityLayers_.find(id);
+    if (found == entityLayers_.end() || !motions_.getLayer(found-&gt;second)) return {};
