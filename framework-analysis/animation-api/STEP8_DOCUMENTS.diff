+            ok = motions.setMotionEnabled(*spinId, spinEnabled);
+        } else if (key == GLFW_KEY_G) {
+            globalEnabled = !globalEnabled;
+            ok = motions.setMotionEnabled(*globalId, globalEnabled);
+        } else if (key == GLFW_KEY_M) {
+            reflection = (reflection + 1) % 4;
+            std::optional&lt;glm::mat4&gt; matrix = glm::mat4(1);
+            if (reflection == 1) matrix = TransformSystem::reflectPlane({0, 0, 0}, {1, 0, 0});
+            if (reflection == 2) matrix = TransformSystem::reflectPoint({0, 0, 0});
+            if (reflection == 3) matrix = TransformSystem::reflectLine(AxisLine{});
+            LayerConfig config;
+            if (!matrix) ok = false;
+            else { config.transform = *matrix; ok = motions.setLayer(*mirrorLayer, config); }
+        } else if (key == GLFW_KEY_I) {
+            if (insertedLayer) {
+                ok = motions.removeLayer(*insertedLayer);
+                if (ok) insertedLayer.reset();
+            } else {
+                LayerConfig config;
+                config.space = TransformSpace::Local;
+                const auto scale = TransformSystem::scaling(glm::vec3(1.5f));
+                if (!scale) ok = false;
+                else {
+                    config.transform = *scale;
+                    insertedLayer = motions.insertLayer(*normalSpinLayer, config);
+                    ok = insertedLayer.has_value();
+                }
+            }
+        }
+        if (!ok) current.requestClose();
+    });
+    app.setMouseHandler([](Application&amp; current, const MouseEvent&amp; event) {
+        if (event.button != GLFW_MOUSE_BUTTON_LEFT || event.action != GLFW_PRESS) return;
+        const auto hit = current.pickAt(event.windowX, event.windowY);
+        if (hit) std::cout &lt;&lt; &quot;entity=&quot; &lt;&lt; hit-&gt;entityId &lt;&lt; &quot; face=&quot; &lt;&lt; hit-&gt;faceIndex &lt;&lt; &#x27;\n&#x27;;
+    });
+    ApplicationConfig config;
+    config.title = &quot;Motion and layer tree&quot;;
+    return app.run(config);
+}</code></pre></details><p><a href="API_REFERENCE.html#case-layers">함수·반환값·실패 조건과 함께 읽기</a></p></section><section id="pattern-path"><h2>경로 전환·왕복</h2><p>공이 원 경로를 따라 이동하고 한 축을 중심으로 도는 상황이다. TransformSystem은 행렬을 계산하고 PathSystem은 진행률을 위치로 바꾸는 함수를 만든다. 이 계산만으로 Scene이 변경되지는 않는다.</p><p>주요 상태: axis.point는 회전축 위의 한 점, direction은 축 방향이다. u는 시간 자체가 아니라 경로 진행률이다. smoothStep은 u를 느리게 시작·끝나는 진행률로 바꾼다.</p><div class="flow"><svg viewBox="0 0 1020 516" role="img" aria-label="pattern-path 흐름도"><title>pattern-path 흐름도</title><defs><marker id="pattern-path-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10Z" fill="#4d688a"/></marker></defs><rect x="70" y="30" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="74" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">PathSystem으로 경로 생성</text><path d="M510 102 V134" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-path-arrow)"/><rect x="70" y="134" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="178" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">PathMotion의 기간·재생 정책 지정</text><path d="M510 206 V238" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-path-arrow)"/><rect x="70" y="238" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="282" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">Motion.followPath 구성</text><path d="M510 310 V342" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-path-arrow)"/><rect x="70" y="342" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="386" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">MotionSystem.setMotion → seekMotion(0)</text></svg></div><h3>실제 응용 코드 묶음</h3><p class="badge">새로 작성한 사용 사례. 같은 API를 쓰는 기존 실행 소스도 아래에 전체 첨부한다.</p><pre><code>void calculateTransforms() {
+    graphics::AxisLine axis{{0,0,0},{0,1,0}};
+    auto t=graphics::TransformSystem::translation({1,0,0});
+    auto s=graphics::TransformSystem::scaling({2,1,1},{0,0,0});
+    auto r=graphics::TransformSystem::rotation(axis,90);
+    auto point=graphics::TransformSystem::reflectPoint({0,0,0});
+    auto line=graphics::TransformSystem::reflectLine(axis);
+    auto plane=graphics::TransformSystem::reflectPlane({0,0,0},{1,0,0});
+    if(!t||!s||!r||!point||!line||!plane) return;
+    bool affine=graphics::TransformSystem::validAffine(*t * *r * *s); (void)affine;
+    auto circle=graphics::PathSystem::circle({0,0,0},2);
+    auto ellipse=graphics::PathSystem::ellipse({0,0,0},{2,0,0},{0,0,1});
+    auto polyline=graphics::PathSystem::polyline({{0,0,0},{1,0,0},{1,0,1}});
+    auto polygon=graphics::PathSystem::polygon({{0,0,0},{1,0,0},{0,0,1}});
+    auto rectangle=graphics::PathSystem::rectangle({0,0,0},{1,0,0},{0,0,1});
+    if(!circle||!ellipse||!polyline||!polygon||!rectangle) return;
+    auto u=graphics::PathSystem::linear(.25);
+    auto eased=graphics::PathSystem::smoothStep(u);
+    glm::vec3 position=circle(eased); (void)position;
+}</code></pre><p>optional 행렬이 비어 있거나 경로 std::function이 비면 입력이 유효하지 않다. 0 길이 축이나 0 반지름을 넘긴 실패를 identity 행렬 성공으로 간주하지 않는다.</p><details><summary>실제 저장소 소스 · framework/detail/Transform.inl</summary><pre><code>#pragma once
+#include &lt;algorithm&gt;
