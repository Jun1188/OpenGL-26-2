+inline HumanoidPose HumanoidPose::seated() {
+    HumanoidPose pose;
+    for (std::size_t i = 0; i &lt; 2; ++i) {
+        pose.hips[i].x = -90;
+        pose.knees[i].x = 90;
+        pose.shoulders[i].x = -20;
+        pose.elbows[i].x = -40;
+    }
+    return pose;
