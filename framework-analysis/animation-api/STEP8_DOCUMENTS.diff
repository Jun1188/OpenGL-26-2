marker-end="url(#pattern-assets-arrow)"/><rect x="70" y="446" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="490" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">RenderOptions.textures로 표시</text></svg></div><h3>실제 응용 코드 묶음</h3><p class="badge">새로 작성한 사용 사례. 같은 API를 쓰는 기존 실행 소스도 아래에 전체 첨부한다.</p><pre><code>bool loadAssets(graphics::Application&amp; app) { // initHandler 안에서 호출
+    auto&amp; loader=app.getAssets();
+    const auto&amp; features=loader.features(); (void)features;
+    graphics::LoadOptions options; options.texturePath=&quot;textures/robot.png&quot;;
+    auto loaded=loader.loadObj(&quot;models/robot.obj&quot;,options);
+    if(!loaded) { std::cerr&lt;&lt;loaded.error; return false; }
+    auto texture=loader.loadTexture(&quot;textures/robot.png&quot;);
+    if(!texture) { std::cerr&lt;&lt;texture.error; return false; }
+    if(!texture.image-&gt;valid()) return false;
+    auto id=app.getScene().addModel(*loaded.model,{},loaded.pivotMode,loaded.localBasis);
+    app.getRenderOptions().textures=true;
+    return id.has_value();
+}
+void standaloneLoader() {
+    graphics::FeatureOptions features; features.textures=true;
+    graphics::AssetLoader loader(&quot;.&quot;,features);
+    auto a=loader.loadPrimitive(&quot;models/cube.obj&quot;);
+    auto b=loader.loadModel(&quot;models/robot.obj&quot;);
+    graphics::TextureImage pixel; pixel.width=1;pixel.height=1;pixel.rgba={255,255,255,255};
+    bool valid=pixel.valid(); (void)a;(void)b;(void)valid;
+}
+// main에서 config.features.textures=true를 설정한 뒤 app.run(config)를 호출한다.</code></pre><p>이 경로는 사용자가 준비해야 하는 사례 자산이다. loadPrimitive/loadModel도 현재는 OBJ 로더를 호출한다. FBX/glTF 로딩을 의미하지 않는다. 이미지 기능을 끄면 해당 로드는 error를 돌려준다.</p><details><summary>실제 저장소 소스 · framework/examples/assets.cpp</summary><pre><code>#include &quot;../Framework.h&quot;
+#include &lt;iostream&gt;
+
+// assets.exe obj framework/examples/data/cube.obj
+// assets.exe obj models/example.obj textures/override.png
+// The old primitive/model mode names remain aliases of obj.
+int main(int argc,char** argv) {
+    if(argc&lt;3){std::cerr&lt;&lt;&quot;Use: assets.exe obj|primitive|model relative-path [relative-texture-path]\n&quot;;return 1;}
+    const std::string mode=argv[1];
+    if(mode!=&quot;obj&quot;&amp;&amp;mode!=&quot;primitive&quot;&amp;&amp;mode!=&quot;model&quot;){std::cerr&lt;&lt;&quot;Unknown mode\n&quot;;return 1;}
+    const auto path=std::filesystem::u8path(argv[2]);
+    const auto texturePath=argc&gt;3?std::filesystem::u8path(argv[3]):std::filesystem::path{};
+    graphics::ApplicationConfig config;
+    config.projectRoot=&quot;.&quot;;
+    config.features.textures=!texturePath.empty();
+    graphics::Application app;
+    app.setInitHandler([&amp;](graphics::Application&amp; app) {
+        graphics::LoadOptions options;
+        options.outline=graphics::OutlineMode::FeatureEdges;
+        options.texturePath=texturePath;
+        const auto loaded=app.getAssets().loadObj(path,options);
+        if(!loaded) return false; // loadObj already printed the error and format guidance.
+        for(const auto&amp; warning:loaded.warnings) std::cerr&lt;&lt;warning&lt;&lt;&#x27;\n&#x27;;
+        return app.getScene().addModel(*loaded.model,graphics::Transform3D{},
+                                      loaded.pivotMode,loaded.localBasis).has_value();
+    });
+    app.setMouseHandler([](graphics::Application&amp; app,const graphics::MouseEvent&amp; event) {
+        if(event.button==GLFW_MOUSE_BUTTON_LEFT&amp;&amp;event.action==GLFW_PRESS)
+            if(const auto hit=app.pickAtCursor())
+                std::cout&lt;&lt;&quot;entity=&quot;&lt;&lt;hit-&gt;entityId&lt;&lt;&quot; mesh=&quot;&lt;&lt;hit-&gt;faceIndex&lt;&lt;&quot; triangle=&quot;&lt;&lt;hit-&gt;triangleIndex&lt;&lt;&#x27;\n&#x27;;
+    });
+    app.setKeyHandler([](graphics::Application&amp; app,int key,int action){
+        if(key==GLFW_KEY_ESCAPE&amp;&amp;action==GLFW_PRESS)app.requestClose();
+    });
+    return app.run(config);
+}</code></pre></details><details><summary>실제 저장소 소스 · framework/include/ModelLoader.h</summary><pre><code>#pragma once
+#include &quot;Geometry.h&quot;
+#include &quot;Texture.h&quot;
+
+namespace graphics {
+struct FeatureOptions { bool textures = false; };
+struct LoadOptions {
+    PivotMode pivot = PivotMode::BottomCenter;
+    glm::vec3 customPivot{0};
+    OutlineMode outline = OutlineMode::None;
+    bool mergeCoplanarFaces = true; // within each OBJ object/group/material/smoothing segment
+    bool flipTextureRows = true;
+    std::filesystem::path texturePath; // project-relative explicit override
+    bool allowObjFallback = true;
+};
+struct ModelResult {
+    std::optional&lt;Model&gt; model;
+    glm::vec3 localBasis{0};
+    PivotMode pivotMode = PivotMode::Preserve;
+    std::string error;
+    std::vector&lt;std::string&gt; warnings;
+    bool usedFallback = false;
+    /// [API] 모델 또는 이미지 결과가 있는지 성공 여부로 변환한다. 실패 시 error 문자열을 확인한다.
+    explicit operator bool() const { return model.has_value(); }
+};
+struct TextureResult {
+    std::shared_ptr&lt;const TextureImage&gt; image;
+    std::string error;
+    /// [API] 모델 또는 이미지 결과가 있는지 성공 여부로 변환한다. 실패 시 error 문자열을 확인한다.
+    explicit operator bool() const { return bool(image); }
+};
+
+namespace detail {
+inline ModelResult finishLoad(Model model,const LoadOptions&amp; options) {
+    if(model.faces.empty()) throw std::runtime_error(&quot;Model contains no triangle meshes.&quot;);
+    for(auto&amp; face:model.faces) {
+        face.outline=options.outline;
+        if(!validMesh(face)) throw std::runtime_error(&quot;Invalid model mesh data.&quot;);
+    }
+    ModelResult result;
+    if(options.pivot==PivotMode::BottomCenter) result.localBasis=bottomCenter(model);
+    else if(options.pivot==PivotMode::Custom) result.localBasis=options.customPivot;
+    if(!finiteVector(result.localBasis)) throw std::runtime_error(&quot;Invalid local basis.&quot;);
+    result.pivotMode=options.pivot;
+    result.model=std::move(model);
+    return result;
+}
+} // namespace detail
+
+class AssetLoader {
+    std::filesystem::path projectRoot_;
+    FeatureOptions features_;
+    mutable std::map&lt;std::filesystem::path,std::weak_ptr&lt;const TextureImage&gt;&gt; imageCache_;
+    std::filesystem::path resolve(const std::filesystem::path&amp; relative) const {
+        if(relative.empty() || relative.is_absolute() || relative.has_root_name())
+            throw std::runtime_error(&quot;Asset path must be project-relative.&quot;);
+        const auto root=std::filesystem::weakly_canonical(projectRoot_);
+        const auto full=std::filesystem::weakly_canonical(root/relative);
+        auto a=root.begin(), b=full.begin();
+        for(;a!=root.end();++a,++b) if(b==full.end() || *a!=*b)
+            throw std::runtime_error(&quot;Asset path is outside projectRoot.&quot;);
+        return full;
+    }
+    std::shared_ptr&lt;const TextureImage&gt; texture(const std::filesystem::path&amp; relative,bool flip) const {
+        if(!features_.textures) throw std::runtime_error(&quot;Texture mode is disabled.&quot;);
+        const auto full=resolve(relative);
+        // The row convention is part of the cache key.
+        const auto key=full / (flip?&quot;#flipped&quot;:&quot;#native&quot;);
+        if(auto cached=imageCache_[key].lock()) return cached;
+        auto image=std::make_shared&lt;const TextureImage&gt;(detail::decodeImage(full,nullptr,flip));
+        imageCache_[key]=image;
+        return image;
+    }
+public:
+    /// [API] 프로젝트 루트와 기능 옵션을 보관하고 상대경로 자산 로딩을 준비한다.
+    explicit AssetLoader(std::filesystem::path projectRoot=detail::executableDirectory(),
+                         FeatureOptions features=FeatureOptions{})
+        : projectRoot_(std::filesystem::absolute(projectRoot)),features_(features) {}
+    /// [API] 로더의 텍스처 등 기능 사용 옵션을 읽기 전용 참조로 반환한다.
+    const FeatureOptions&amp; features() const { return features_; }
+    /// [API] 프로젝트 상대경로의 이미지를 읽어 TextureResult로 반환한다. 실패 원인은 error에 담는다.
+    TextureResult loadTexture(const std::filesystem::path&amp; relative,bool flipRows=true) const {
+        try { return {texture(relative,flipRows),{}}; }
+        catch(const std::exception&amp; e) { return {nullptr,e.what()}; }
+    }
+    /// [API] 프로젝트 상대경로의 OBJ를 직접 파싱하여 모델·피벗·경고·오류 결과를 반환한다.
+    ModelResult loadObj(const std::filesystem::path&amp; relative,const LoadOptions&amp; options=LoadOptions{}) const;
+    /// [API] 기본 도형 OBJ를 읽는 호환 진입점이다. OBJ 로더로 처리를 위임한다.
+    ModelResult loadPrimitive(const std::filesystem::path&amp; relative,const LoadOptions&amp; options=LoadOptions{}) const;
+    /// [API] 모델 로딩 호환 진입점이다. 현재 구현은 loadObj로 위임하며 다른 형식 변환은 하지 않는다.
+    ModelResult loadModel(const std::filesystem::path&amp; relative,const LoadOptions&amp; options=LoadOptions{}) const;
+};
+} // namespace graphics
+
+#include &quot;../detail/PrimitiveLoader.inl&quot;
+#include &quot;../detail/ObjLoader.inl&quot;
+namespace graphics {
+/// [API] 모델 로딩 호환 진입점이다. 현재 구현은 loadObj로 위임하며 다른 형식 변환은 하지 않는다.
+inline ModelResult AssetLoader::loadModel(const std::filesystem::path&amp; relative,const LoadOptions&amp; options) const {
+    return loadObj(relative,options);
+}
+} // namespace graphics</code></pre></details><p><a href="API_REFERENCE.html#case-assets">함수·반환값·실패 조건과 함께 읽기</a></p></section><section id="pattern-linear"><h2>두 위치 사이 선형보간</h2><p>상자가 2초 이동한 뒤 1초 회전하는 모션을 편집한다. append는 단계를 배열에 더할 뿐 시작 시간을 뒤로 밀지 않는다. 순차 실행은 then을 사용한다.</p><p>주요 상태: Motion은 단계들의 값 묶음이다. MotionStep의 콜백이 받는 초는 해당 단계가 시작된 이후의 시간이다. sample(2.5)는 dt=.5가 아니라 모션 시작 후 2.5초의 자세를 요구한다.</p><div class="flow"><svg viewBox="0 0 1020 516" role="img" aria-label="pattern-linear 흐름도"><title>pattern-linear 흐름도</title><defs><marker id="pattern-linear-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10Z" fill="#4d688a"/></marker></defs><rect x="70" y="30" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="74" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">from·to·편도 시간 지정</text><path d="M510 102 V134" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-linear-arrow)"/><rect x="70" y="134" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="178" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">Playback 선택</text><path d="M510 206 V238" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-linear-arrow)"/><rect x="70" y="238" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="282" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">Motion.linear로 단계 생성</text><path d="M510 310 V342" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-linear-arrow)"/><rect x="70" y="342" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="386" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">MotionSystem 또는 관절 트랙에서 시간 샘플링</text></svg></div><h3>실제 응용 코드 묶음</h3><p class="badge">새로 작성한 사용 사례. 같은 API를 쓰는 기존 실행 소스도 아래에 전체 첨부한다.</p><pre><code>std::optional&lt;graphics::Motion&gt; makeMotion() {
+    graphics::Motion motion;
+    graphics::LinearMotion move; move.to={2,0,0}; move.durationSeconds=2;
+    if(!motion.append(graphics::Motion::linear(move))) return {};
+    graphics::RotationMotion spin; spin.degreesPerSecond=90;
+    auto rotate=graphics::Motion::rotation(spin); rotate.durationSeconds=1;
+    if(!motion.then(rotate)) return {};
+    auto fixed=graphics::Motion::fixed(glm::mat4(1));
+    if(!motion.insert(0,fixed)||!motion.replace(0,fixed)||!motion.erase(0)) return {};
+    const auto&amp; steps=motion.getSteps(); (void)steps;
+    auto pose=motion.sample(2.5); if(!pose) return {};
+    graphics::PathMotion path; path.path=graphics::PathSystem::circle({0,0,0},1);
+    graphics::Motion looping;
+    if(!looping.append(graphics::Motion::followPath(path))) return {};
+    graphics::PendulumMotion sway; sway.periodSeconds=3;
+    graphics::Motion pendulum;
+    if(!pendulum.append(graphics::Motion::pendulum(sway))) return {};
+    return motion;
+}</code></pre><p>유한 종료 시간이 없는 루프 단계 뒤에는 then을 사용할 수 없다. Once 단계는 종료 자세를 유지한다. 진자는 중력 적분이 아니라 지정 주기의 sin 각도 함수다.</p><details><summary>실제 저장소 소스 · framework/detail/Motion.inl</summary><pre><code>#pragma once
+#include &lt;algorithm&gt;
+#include &lt;stdexcept&gt;
+
+namespace graphics {
+inline bool Motion::validStep(const MotionStep&amp; step) {
+    return bool(step.transform) &amp;&amp; std::isfinite(step.startSeconds) &amp;&amp; step.startSeconds &gt;= 0
+        &amp;&amp; (!step.durationSeconds || (std::isfinite(*step.durationSeconds)
+            &amp;&amp; *step.durationSeconds &gt;= 0
+            &amp;&amp; std::isfinite(step.startSeconds + *step.durationSeconds)));
+}
+inline bool Motion::append(const MotionStep&amp; step) { return insert(steps_.size(), step); }
+inline bool Motion::insert(std::size_t index, const MotionStep&amp; step) {
+    if (index &gt; steps_.size() || !validStep(step)) return Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;Motion::insert&quot;, &quot;Rejected condition: index &gt; steps_.size() || !validStep(step)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;);
+    steps_.insert(steps_.begin() + index, step);
+    return true;
+}
+inline bool Motion::replace(std::size_t index, const MotionStep&amp; step) {
+    if (index &gt;= steps_.size() || !validStep(step)) return Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;Motion::replace&quot;, &quot;Rejected condition: index &gt;= steps_.size() || !validStep(step)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;);
