+            if(const auto hit=app.pickAtCursor())
+                std::cout&lt;&lt;&quot;entity=&quot;&lt;&lt;hit-&gt;entityId&lt;&lt;&quot; mesh=&quot;&lt;&lt;hit-&gt;faceIndex&lt;&lt;&quot; triangle=&quot;&lt;&lt;hit-&gt;triangleIndex&lt;&lt;&#x27;\n&#x27;;
+    });
