p><pre><code>std::optional&lt;graphics::Motion&gt; makeMotion() {
+    graphics::Motion motion;
+    graphics::LinearMotion move; move.to={2,0,0}; move.durationSeconds=2;
+    if(!motion.append(graphics::Motion::linear(move))) return {};
+    graphics::RotationMotion spin; spin.degreesPerSecond=90;
+    auto rotate=graphics::Motion::rotation(spin); rotate.durationSeconds=1;
+    if(!motion.then(rotate)) return {};
+    auto fixed=graphics::Motion::fixed(glm::mat4(1));
+    if(!motion.insert(0,fixed)||!motion.replace(0,fixed)||!motion.erase(0)) return {};
+    const auto&amp; steps=motion.getSteps(); (void)steps;
+    auto pose=motion.sample(2.5); if(!pose) return {};
+    graphics::PathMotion path; path.path=graphics::PathSystem::circle({0,0,0},1);
+    graphics::Motion looping;
+    if(!looping.append(graphics::Motion::followPath(path))) return {};
+    graphics::PendulumMotion sway; sway.periodSeconds=3;
+    graphics::Motion pendulum;
+    if(!pendulum.append(graphics::Motion::pendulum(sway))) return {};
+    return motion;
+}</code></pre><p>유한 종료 시간이 없는 루프 단계 뒤에는 then을 사용할 수 없다. Once 단계는 종료 자세를 유지한다. 진자는 중력 적분이 아니라 지정 주기의 sin 각도 함수다.</p><details><summary>실제 저장소 소스 · framework/detail/Motion.inl</summary><pre><code>#pragma once
+#include &lt;algorithm&gt;
+#include &lt;stdexcept&gt;
+
+namespace graphics {
+inline bool Motion::validStep(const MotionStep&amp; step) {
+    return bool(step.transform) &amp;&amp; std::isfinite(step.startSeconds) &amp;&amp; step.startSeconds &gt;= 0
+        &amp;&amp; (!step.durationSeconds || (std::isfinite(*step.durationSeconds)
+            &amp;&amp; *step.durationSeconds &gt;= 0
+            &amp;&amp; std::isfinite(step.startSeconds + *step.durationSeconds)));
+}
+inline bool Motion::append(const MotionStep&amp; step) { return insert(steps_.size(), step); }
+inline bool Motion::insert(std::size_t index, const MotionStep&amp; step) {
+    if (index &gt; steps_.size() || !validStep(step)) return Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;Motion::insert&quot;, &quot;Rejected condition: index &gt; steps_.size() || !validStep(step)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;);
+    steps_.insert(steps_.begin() + index, step);
+    return true;
+}
+inline bool Motion::replace(std::size_t index, const MotionStep&amp; step) {
+    if (index &gt;= steps_.size() || !validStep(step)) return Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;Motion::replace&quot;, &quot;Rejected condition: index &gt;= steps_.size() || !validStep(step)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;);
+    steps_[index] = step;
+    return true;
+}
+inline bool Motion::erase(std::size_t index) {
+    if (index &gt;= steps_.size()) return Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;Motion::erase&quot;, &quot;Rejected condition: index &gt;= steps_.size()&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;);
+    steps_.erase(steps_.begin() + index);
