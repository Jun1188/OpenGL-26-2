+inline std::optional&lt;MotionSample&gt; MotionSystem::layerMatrices(LayerId leaf) const {
+    std::vector&lt;LayerId&gt; chain;
+    auto current = std::optional&lt;LayerId&gt;(leaf);
+    while (current) {
+        const auto layer = getLayer(*current);
+        if (!layer || chain.size() &gt;= layers_.size()) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::layerMatrices&quot;, &quot;Rejected condition: !layer || chain.size() &gt;= layers_.size()&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+        chain.push_back(*current);
+        current = layer-&gt;parent;
+    }
+    MotionSample result;
+    for (auto i = chain.rbegin(); i != chain.rend(); ++i) {
+        const auto&amp; config = layers_.at(*i).config;
+        if (!config.enabled) continue;
+        MotionSample own;
+        if (config.space == TransformSpace::World) own.parent = config.transform;
+        else own.local = config.transform;
+        if (config.motion) {
+            const auto state = getMotion(*config.motion);
+            if (!state) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::layerMatrices&quot;, &quot;Rejected condition: !state&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+            if (state-&gt;enabled) {
+                own.parent = state-&gt;sampled.parent * own.parent;
+                own.local = state-&gt;sampled.local * own.local;
+            }
+        }
+        if (*i == rootLayer()) result.parent = own.parent * own.local;
+        else {
+            result.parent *= own.parent;
+            result.local *= own.local;
+        }
+        if (!TransformSystem::validAffine(result.parent)
+            || !TransformSystem::validAffine(result.local)) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::layerMatrices&quot;, &quot;Rejected condition: !TransformSystem::validAffine(result.parent) || !TransformSystem::validAffine(result.local)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    }
+    return result;
+}
+inline std::optional&lt;MotionId&gt; MotionSystem::createSpin(RotationMotion config) {
+    config.space = TransformSpace::Local;
+    Motion motion;
+    if (!motion.append(Motion::rotation(config))) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::createSpin&quot;, &quot;Rejected condition: !motion.append(Motion::rotation(config))&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    return createMotion(motion);
+}
+inline std::optional&lt;MotionId&gt; MotionSystem::createOrbit(RotationMotion config) {
+    config.space = TransformSpace::World;
+    Motion motion;
+    if (!motion.append(Motion::rotation(config))) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::createOrbit&quot;, &quot;Rejected condition: !motion.append(Motion::rotation(config))&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    return createMotion(motion);
+}
+inline std::optional&lt;MotionId&gt; MotionSystem::createOrbitAndSpin(RotationMotion orbit,
+                                                            RotationMotion spin) {
+    orbit.space = TransformSpace::World;
+    spin.space = TransformSpace::Local;
+    Motion motion;
+    if (!motion.append(Motion::rotation(orbit)) || !motion.append(Motion::rotation(spin))) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::createOrbitAndSpin&quot;, &quot;Rejected condition: !motion.append(Motion::rotation(orbit)) || !motion.append(Motion::rotation(spin))&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    return createMotion(motion);
+}
+inline std::optional&lt;MotionId&gt; MotionSystem::createPathAndSpin(const PathMotion&amp; path,
+                                                           RotationMotion spin) {
+    spin.space = TransformSpace::Local;
+    Motion motion;
+    if (!motion.append(Motion::followPath(path)) || !motion.append(Motion::rotation(spin))) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Motion, &quot;MotionSystem::createPathAndSpin&quot;, &quot;Rejected condition: !motion.append(Motion::followPath(path)) || !motion.append(Motion::rotation(spin))&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    return createMotion(motion);
+}
+} // namespace graphics</code></pre></details><p><a href="API_REFERENCE.html#case-motion">함수·반환값·실패 조건과 함께 읽기</a></p></section><section id="pattern-grid"><h2>격자 비율·셀·지그재그 배치</h2><p>가로 10칸 바닥에 장애물을 배치한다. 셀 번호는 이산 인덱스이고 비율은 전체 영역을 0~1로 표현하는 연속 값이다. 두 입력의 의미를 섞지 않는다.</p><p>주요 상태: origin은 최소 모서리, extent는 전체 크기, cells는 분할 수다. frame은 격자 좌표를 월드로 바꾼다. parentWorld는 배치할 부모의 월드 행렬이다.</p><div class="flow"><svg viewBox="0 0 1020 516" role="img" aria-label="pattern-grid 흐름도"><title>pattern-grid 흐름도</title><defs><marker id="pattern-grid-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10Z" fill="#4d688a"/></marker></defs><rect x="70" y="30" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="74" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">origin·extent·cells 설정</text><path d="M510 102 V134" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-grid-arrow)"/><rect x="70" y="134" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="178" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">셀 중심·로컬 크기 계산</text><path d="M510 206 V238" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-grid-arrow)"/><rect x="70" y="238" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="282" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">snakeCells로 방문 순서 구성</text><path d="M510 310 V342" stroke="#4d688a" stroke-width="2" marker-end="url(#pattern-grid-arrow)"/><rect x="70" y="342" width="880" height="72" rx="10" fill="#e8f0fb" stroke="#6a8ebc"/><text x="510" y="386" text-anchor="middle" font-size="20" font-family="Malgun Gothic,sans-serif" fill="#1d2c40">Scene에 반복 배치</text></svg></div><h3>실제 응용 코드 묶음</h3><p class="badge">새로 작성한 사용 사례. 같은 API를 쓰는 기존 실행 소스도 아래에 전체 첨부한다.</p><pre><code>bool placeOnGrid(graphics::Scene&amp; scene) {
+    graphics::GridLayout grid; grid.origin={-5,0,-5}; grid.extent={10,2,10};grid.cells={10,2,10};
+    if(!grid.valid()) return false;
+    auto middle=grid.position({.5f,0,.5f});
+    auto cell=grid.cellCenter({2,0,3});
+    auto size=grid.relativeSize({.1f,.25f,.1f});
+    auto local=grid.positionInParent({.5f,0,.5f},glm::mat4(1));
+    if(!middle||!cell||!size||!local) return false;
+    auto index=grid.cellAt(*cell); if(!index) return false;
+    auto order=graphics::PatternSystem::snakeCells({10,1,10}); (void)order;
+    auto snapped=graphics::PatternSystem::snap(*cell,1);
+    bool aligned=graphics::PatternSystem::aligned(snapped.x,cell-&gt;x,.01f); (void)aligned;
+    return graphics::PatternSystem::addBox(scene,*size,*cell,{.6f,.7f,.8f}).has_value();
+}</code></pre><p>cellCenter({2,0,3})는 (-2.5,.5,-1.5)다. relativeSize는 로컬 크기를 반환하므로 frame의 비균일 배율을 이미 적용한 월드 크기로 착각하지 않는다.</p><details><summary>실제 저장소 소스 · standard/Console.cpp</summary><pre><code>#include &quot;Console.h&quot;
+#include &lt;iostream&gt;
