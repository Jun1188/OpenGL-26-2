+    auto cube=graphics::DiagramSystem::makePolyhedron(graphics::GLShape::Cube,{1,1,1});
+    auto sphere=graphics::DiagramSystem::makeSphere(.5f);
+    auto cone=graphics::DiagramSystem::makeCone(.5f,1);
+    bool valid=graphics::DiagramSystem::validPolyhedron(cube);
+    graphics::Transform3D transform;
+    valid=graphics::DiagramSystem::validTransform(transform)&amp;&amp;valid;
+    auto matrix=graphics::DiagramSystem::modelMatrix(transform);
+    if(!component.polyhedron.faces.empty()) {
+        auto face=graphics::DiagramSystem::faceModelMatrix(component,component.polyhedron.faces[0]);
+        (void)face;
+    }
+    (void)sphere;(void)cone;(void)valid;(void)matrix;
+}</code></pre><p>validPolyhedron은 면 구성의 유효성을, validTransform은 회전 기저와 수치의 유효성을 다룬다. 둘 중 하나의 성공이 다른 하나의 성공을 보장하지 않는다.</p><details><summary>실제 저장소 소스 · framework/detail/Scene.inl</summary><pre><code>#pragma once
+#include &lt;fstream&gt;
+#include &lt;initializer_list&gt;
+#include &lt;iostream&gt;
+#include &lt;sstream&gt;
+#include &lt;utility&gt;
+
+namespace graphics {
+namespace detail {
+
+inline bool positiveLengths(const glm::vec3&amp; value) {
+    return finiteVector(value) &amp;&amp; value.x &gt; 0.0f
+        &amp;&amp; value.y &gt; 0.0f &amp;&amp; value.z &gt; 0.0f;
+}
+
+inline std::uint64_t nextGeometryRevision() {
+    // 장면 복사·교체 시에도 다른 형상에 같은 revision을 부여하지 않는다.
+    // Scene과 Renderer는 한 렌더링 스레드에서 사용한다.
+    static std::uint64_t revision = 0;
+    return ++revision;
+}
+
+inline void appendFace(Polyhedron&amp; polyhedron, GLFace shape,
+                std::initializer_list&lt;glm::vec3&gt; vertices, GlColor color) {
+    PlaneFigure face;
+    face.shape = shape;
+    face.localVertices = vertices;
+    face.color = color;
+    face.normal = glm::normalize(glm::cross(
+        face.localVertices[1] - face.localVertices[0],
+        face.localVertices[2] - face.localVertices[0]));
+    polyhedron.faces.push_back(face);
+}
+
+} // namespace detail
+using detail::finiteVector;
+using detail::finiteMatrix;
+using detail::validColor;
+using detail::positiveLengths;
+using detail::nextGeometryRevision;
+using detail::appendFace;
+
+inline Scene::Scene() {
+    geometryRevision_ = nextGeometryRevision();
+    polyId_.reserve(MAX_ENTITIES);
+    components_.reserve(MAX_ENTITIES);
+    tetraFaceId_.reserve(MAX_ENTITIES * 4);
+    cubeFaceId_.reserve(MAX_ENTITIES * 6);
+    pyramidFaceId_.reserve(MAX_ENTITIES * 5);
+    lines_.reserve(MAX_LINES);
+}
+
+inline std::optional&lt;EntityId&gt; Scene::addGroup(const Transform3D&amp; transform) {
+    if(!DiagramSystem::validTransform(transform))return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Scene, &quot;Scene::addGroup&quot;, &quot;Rejected condition: !DiagramSystem::validTransform(transform)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    const auto id=components_.size();
+    Component_Poly group;group.polyhedron.shape=GLShape::None;
+    group.transform=transform;group.sideLengths=glm::vec3(0);group.transformOnly=true;
+    components_.push_back(group);polyId_.push_back(id);
+    geometryRevision_=nextGeometryRevision();return id;
+}
+inline bool Scene::setTint(EntityId id, GlColor color) {
+    if(id&gt;=components_.size() || !validColor(color))return Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Scene, &quot;Scene::setTint&quot;, &quot;Rejected condition: id&gt;=components_.size() || !validColor(color)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;, id);
+    components_[id].tint=color;return true;
+}
+inline std::optional&lt;EntityId&gt; Scene::addSphere(float radius,const glm::vec3&amp; position,unsigned slices,unsigned stacks) {
+    Transform3D transform;transform.basis=position;
+    return push_entity(DiagramSystem::makeSphere(radius,slices,stacks),transform);
+}
+inline std::optional&lt;EntityId&gt; Scene::addCone(float radius,float height,const glm::vec3&amp; position,unsigned slices) {
+    Transform3D transform;transform.basis=position;
+    return push_entity(DiagramSystem::makeCone(radius,height,slices),transform);
+}
+
+inline std::optional&lt;EntityId&gt; Scene::push_entity(
+    const Polyhedron&amp; polyhedron, const Transform3D&amp; transform
+) {
+    if (!DiagramSystem::validPolyhedron(polyhedron)
+        || !DiagramSystem::validTransform(transform)) {
+        return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Scene, &quot;Scene::push_entity&quot;, &quot;Rejected condition: !DiagramSystem::validPolyhedron(polyhedron) || !DiagramSystem::validTransform(transform)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    }
+    glm::vec3 minimum = polyhedron.faces[0].localVertices[0];
+    glm::vec3 maximum = minimum;
+    for (const PlaneFigure&amp; face : polyhedron.faces) {
+        for (const glm::vec3&amp; vertex : face.localVertices) {
+            minimum = glm::min(minimum, vertex);
+            maximum = glm::max(maximum, vertex);
+        }
+    }
+    if (!finiteVector(maximum - minimum)) return (Diagnostics::failAt(__FILE__,__LINE__,PipelineStage::Scene, &quot;Scene::push_entity&quot;, &quot;Rejected condition: !finiteVector(maximum - minimum)&quot;, &quot;Check finite values, valid IDs, dimensions, indices and parent/layer relationships.&quot;), std::nullopt);
+    const EntityId id = components_.size();
+    components_.push_back({ polyhedron, transform, maximum - minimum });
+    polyId_.push_back(id);
+    std::vector&lt;FaceId&gt;* faceIds = nullptr;
+    if (polyhedron.shape == GLShape::Cube) faceIds = &amp;cubeFaceId_;
+    if (polyhedron.shape == GLShape::Tetra) faceIds = &amp;tetraFaceId_;
+    if (polyhedron.shape == GLShape::Pyramid) faceIds = &amp;pyramidFaceId_;
+    if (faceIds) for (std::size_t i = 0; i &lt; polyhedron.faces.size(); ++i)
+        faceIds-&gt;push_back({id, i});
+    geometryRevision_ = nextGeometryRevision();
+    return id;
+}
