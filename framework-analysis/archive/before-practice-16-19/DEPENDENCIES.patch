diff --git a/openGL_3dAssign_13/framework/dependencies/glm/glm/gtx/texture.inl b/openGL_3dAssign_13/framework/dependencies/glm/glm/gtx/texture.inl
new file mode 100644
index 0000000..fd1cfd8
--- /dev/null
+++ b/openGL_3dAssign_13/framework/dependencies/glm/glm/gtx/texture.inl
@@ -0,0 +1,17 @@
+﻿/// @ref gtx_texture
+
+namespace glm
+{
+	template <length_t L, typename T, qualifier Q>
+	inline T levels(vec<L, T, Q> const& Extent)
+	{
+		return glm::log2(compMax(Extent)) + static_cast<T>(1);
+	}
+
+	template <typename T>
+	inline T levels(T Extent)
+	{
+		return levels(vec<1, T, defaultp>(Extent));
+	}
+}//namespace glm
