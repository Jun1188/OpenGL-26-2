+	template<length_t L, typename T, qualifier Q, bool Aligned>
+	struct convert_splat {
+		template<int c>
+		GLM_FUNC_QUALIFIER GLM_CONSTEXPR static vec<L, T, Q> call(vec<L, T, Q> const& a)
+		{
+			vec<L, T, Q> v(T(0));
+			for (int i = 0; i < L; ++i)
