index 0000000..34aee2b
--- /dev/null
+++ b/openGL_3dAssign_13/framework/dependencies/glm/glm/gtx/projection.inl
@@ -0,0 +1,10 @@
+﻿/// @ref gtx_projection
+
+namespace glm
+{
+	template<typename genType>
+	GLM_FUNC_QUALIFIER genType proj(genType const& x, genType const& Normal)
+	{
+		return glm::dot(x, Normal) / glm::dot(Normal, Normal) * Normal;
+	}
+}//namespace glm
