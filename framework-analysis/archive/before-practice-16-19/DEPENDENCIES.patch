+	template<length_t L, typename T, qualifier Q>
+	struct compute_vec_bitwise_not<L, T, Q, true, 32, true>
+	{
+		GLM_FUNC_QUALIFIER static vec<L, T, Q> call(vec<L, T, Q> const& v)
+		{
+			vec<L, T, Q> Result;
+			Result.data = _mm_xor_si128(v.data, _mm_set1_epi32(-1));
+			return Result;
+		}
+	};
