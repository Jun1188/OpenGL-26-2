+		{
+			vec<L, double, Q> Result;
+#	if GLM_ARCH & GLM_ARCH_AVX_BIT
+			Result.data = _mm256_div_pd(a.data, b.data);
+#	else
+			Result.data.setv(0,  _mm_div_pd(a.data.getv(0), b.data.getv(0)));
