+	{
+		static vec<L, float, Q> call(vec<L, float, Q> const& a, vec<L, float, Q> const& b)
+		{
+			vec<L, float, Q> Result;
+			Result.data = vmulq_f32(a.data, b.data);
+			return Result;
+		}
+	};
