+	template<length_t L, typename T, qualifier Q>
+	struct compute_vec_and<L, T, Q, -1, 32, true>
+	{
+		GLM_FUNC_QUALIFIER static vec<L, T, Q> call(vec<L, T, Q> const& a, vec<L, T, Q> const& b)
+		{
+			vec<L, T, Q> Result;
